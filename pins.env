# pins.env -- what one xscape release is built from (sourced by build_wheel.sh).
#
# Local test builds (rollout step 2) use the checkout in XSCAPE_SRC as it is and record
# its commits in BUILD_INFO.txt; the release build (step 3) checks these out fresh.

XSCAPE_VERSION=0.2.0          # the wheel's version (PEP 440)
PYJETSCAPE_VERSION=1.4             # js-contrib's release tag v<this>, JS_CONTRIB_REF its commit
                                   # (before js-contrib 905aae0: pyproject.toml's version)

XSCAPE_REPO=https://github.com/JETSCAPE/X-SCAPE.git
XSCAPE_REF=44cad1d0855017a7ee4cb4a490261af8bb6a07ea        # contrib, JETSCAPE/X-SCAPE#188 merged (multi_hard #187 before it)
JS_CONTRIB_REF=c29095cb4cbc21aa2dce3738fb450c67cd336613    # main, jhputschke/js-contrib#84 merged (multi_hard #83 before it)
MUSIC4GPU_REF=3892302675994afce2ed777d37851e3a363f3ef3     # XSCAPE (PR #23 merged)
ISS_REF=6ac0333125f2a8521120eb4580e828cde428166e           # get_iSS.sh pin
GLAUBER_REF=b99d680b2f2d44694053232804386d3d60474c04       # get_3dglauber.sh pin
LBT_TABLES_COMMIT=76f11234f5baec5d083723a9ad427618534aff01 # JETSCAPE/LBT-tables

PYTHON_VERSION=3.13
MACOSX_DEPLOYMENT_TARGET=26.0
